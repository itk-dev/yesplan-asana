{
    "name": "itk-dev/yesplan-asana",
    "description": "Application for ",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^2.8",
        "doctrine/doctrine-migrations-bundle": "^3.2",
        "doctrine/orm": "^2.14",
        "gedmo/doctrine-extensions": "^3.11",
        "stof/doctrine-extensions-bundle": "^1.7",
        "symfony/console": "~6.2.0",
        "symfony/dotenv": "~6.2.0",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "~6.2.0",
        "symfony/http-client": "~6.2.0",
        "symfony/mailer": "~6.2.0",
        "symfony/monolog-bundle": "^3.8",
        "symfony/options-resolver": "~6.2.0",
        "symfony/runtime": "~6.2.0",
        "symfony/yaml": "~6.2.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.47",
        "friendsofphp/php-cs-fixer": "^3.14",
        "symfony/maker-bundle": "^1.48"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "6.2.*"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "coding-standards-apply": [
            "@coding-standards-apply/php-cs-fixer"
        ],
        "coding-standards-apply/php-cs-fixer": [
            "php-cs-fixer --config=.php-cs-fixer.dist.php fix"
        ],
        "coding-standards-check": [
            "@coding-standards-check/php-cs-fixer"
        ],
        "coding-standards-check/php-cs-fixer": [
            "php-cs-fixer --config=.php-cs-fixer.dist.php fix --dry-run"
        ]
    }
}
